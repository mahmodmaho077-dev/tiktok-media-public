  },
  {
   "vo": "In May twenty twenty-three, Netflix started charging for it. Many called it a mistake.",
   "captions": [["In May 2023,", 4], ["Netflix started charging", 3], ["for it.", 2], ["Many called it", 3], ["a *mistake.*", 2]],
